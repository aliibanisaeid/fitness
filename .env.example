# API listens on localhost. Set HOST=0.0.0.0 only for your production server.
PORT=3190
HOST=127.0.0.1
# Server-side GapGPT configuration. Never expose the key in browser variables.
GAPGPT_API_KEY=
AI_BASE_URL=https://api.gapgpt.app/v1
AI_MODEL=gpt-6-luna
# Saturday 09:00, Asia/Tehran. The server must be running.
ARTICLE_CRON=0 9 * * 6
ARTICLE_TIMEZONE=Asia/Tehran
ARTICLE_REVIEW_REQUIRED=false
# Set a strong token to enable protected request management and editorial APIs.
ADMIN_TOKEN=
